{
  "name": "pixel-pet",
  "version": "1.8.1",
  "description": "A tiny pixel-art crab that walks the taskbar on your Windows desktop",
  "main": "main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jin3107/pixel-pet.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis && node scripts/postbuild.js"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "rcedit": "^5.0.2"
  },
  "build": {
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "afterPack": "scripts/afterPack.js",
    "appId": "com.rainy.pixelpet",
    "productName": "Pixel Pet",
    "files": [
      "main.js",
      "config.js",
      "brain.js",
      "awareness/**",
      "preload.js",
      "bubblePreload.js",
      "settingsPreload.js",
      "modelPickerPreload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pixel Pet",
      "artifactName": "pixel-pet.exe",
      "uninstallDisplayName": "${productName} ${version}"
    },
    "directories": {
      "output": "dist"
    }
  },
  "allowScripts": {
    "electron@45.3.1": true
  }
}
